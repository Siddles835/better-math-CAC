# Google Cloud TTS (dev only; never commit keys)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_TTS_API_KEY=

# OpenAI TTS (server-only — set on Vercel / hosting, never VITE_*)
# Powers /api/tts with gpt-4o-mini-tts for clearer read-aloud.
# OPENAI_API_KEY=

# Optional absolute API origin for Capacitor / native builds
# VITE_TTS_API_URL=https://your-mathlift-host.example

# Class photo sharing (OFF). Do not enable until Firestore rules tighten.
# VITE_ENABLE_CLASS_PHOTO_SHARING=false
